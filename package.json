{
	"name": "obsidian-crate",
	"version": "0.1.0",
	"description": "Sync vault files and reminders with Cloudflare R2.",
	"main": "main.js",
	"type": "module",
	"author": "Kaan Biryol",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kaanbiryol/obsidian-crate.git"
	},
	"bugs": {
		"url": "https://github.com/kaanbiryol/obsidian-crate/issues"
	},
	"homepage": "https://github.com/kaanbiryol/obsidian-crate#readme",
	"engines": {
		"node": "^20.19.0 || ^22.12.0 || >=24.0.0"
	},
	"scripts": {
		"build:site": "npm run build:site:main && npm run build:site:crate-ui",
		"build:site:main": "npx @tailwindcss/cli -i ./site/assets/site.css -o ./site/assets/site.generated.css --minify",
		"build:site:crate-ui": "npx @tailwindcss/cli -i ./site/website-options/crate-ui/source.css -o ./site/website-options/crate-ui/crate-ui.generated.css --minify",
		"dev:site": "npx @tailwindcss/cli -i ./site/assets/site.css -o ./site/assets/site.generated.css --watch",
		"build:worker": "node scripts/build-worker.mjs",
		"build:plugin": "vite build",
		"build:plugin:dev": "vite build --mode development",
		"preview:pwa": "node scripts/pwa-preview.mjs",
		"test:pwa-preview": "node scripts/pwa-smoke-test.mjs",
		"dev": "node scripts/dev.mjs",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"typecheck:worker": "tsc -p src/cloudflare/worker/tsconfig.json --noEmit -skipLibCheck",
		"build": "npm run build:worker && npm run typecheck && npm run build:plugin",
		"size-check:plugin": "node scripts/check-bundle-size.mjs plugin",
		"size-check:worker": "node scripts/check-bundle-size.mjs worker",
		"size-check:pwa": "node scripts/check-bundle-size.mjs pwa",
		"size-check": "npm run size-check:plugin && npm run size-check:worker && npm run size-check:pwa",
		"check:css-scope": "node scripts/check-css-scope.mjs",
		"verify:release-artifacts": "node scripts/verify-release-artifacts.mjs",
		"release:check": "npm run check && npm run build:plugin && npm run check:css-scope && npm run size-check && npm run verify:release-artifacts",
		"predeploy": "npm run build:worker && npm run db:init:remote",
		"deploy": "npx --yes wrangler@4.123.0 deploy",
		"db:init:remote": "npx --yes wrangler@4.123.0 d1 execute DB --remote --file src/cloudflare/schema.sql",
		"deploy:plugin": "node scripts/deploy.mjs",
		"deploy:plugin:configure": "node scripts/deploy.mjs --configure",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"deadcode": "knip",
		"test": "vitest run",
		"check": "npm run build:worker && npm run lint && npm run typecheck && npm run typecheck:worker && npm test"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"cloudflare",
		"r2",
		"sync",
		"reminders"
	],
	"license": "0BSD",
	"devDependencies": {
		"@codemirror/language": "^6.11.3",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "9.30.1",
		"@preact/preset-vite": "^2.10.2",
		"@rollup/plugin-replace": "^6.0.2",
		"@tailwindcss/cli": "4.1.17",
		"@tailwindcss/postcss": "^4.1.17",
		"@types/node": "^22.19.15",
		"@types/react": "^19.2.5",
		"@types/react-dom": "^19.2.3",
		"autoprefixer": "^10.4.22",
		"chokidar": "^4.0.3",
		"esbuild": "^0.28.1",
		"eslint": "^9.30.1",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "14.0.0",
		"knip": "^6.16.1",
		"postcss": "^8.5.6",
		"preact": "^10.27.2",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"sass": "^1.89.0",
		"tailwindcss": "^4.1.17",
		"tslib": "2.4.0",
		"typescript": "^5.8.3",
		"typescript-eslint": "8.35.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@heroui/react": "^2.8.5",
		"@internationalized/date": "^3.8.2",
		"chrono-node": "^2.9.0",
		"classnames": "^2.5.1",
		"date-fns": "^4.1.0",
		"framer-motion": "^12.23.24",
		"lucide-react": "^0.562.0",
		"motion": "^12.38.0",
		"obsidian": "latest",
		"qrcode-generator": "^2.0.4",
		"react-modal-sheet": "^5.6.0",
		"web-push-browser": "^1.4.2",
		"zustand": "^5.0.6"
	}
}
