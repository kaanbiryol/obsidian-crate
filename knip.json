{
	"$schema": "./node_modules/knip/schema.json",
	"entry": [
		"src/main.ts!",
		"src/cloudflare/worker/index.ts!",
		"src/pwa/main.tsx!",
		"scripts/*.mjs",
		"tests/editor-contract/fixture.tsx",
		"tests/editor-contract/*.spec.ts",
		"tests/editor-contract/*.config.{ts,mts}",
		"tests/reading-extraction/*.ts",
		"src/pwa/encrypted-push.ts!"
	],
	"project": [
		"tests/visual/**/*.{ts,tsx}",
		"tests/editor-contract/**/*.{ts,tsx,mts}",
		"src/**/*.{ts,tsx}!",
		"scripts/*.mjs",
		"*.{js,mjs,mts,ts}",
		"packages/server/src/**/*.mjs",
		"!src/**/*-test-harness.ts!",
		"!src/test/**!",
		"tests/reading-extraction/*.ts"
	],
	"ignoreDependencies": [
		"cloudflare",
		"electron",
		"tailwindcss"
	],
	"ignoreBinaries": [
		"plutil",
		"shortcuts",
		"openssl"
	]
}
