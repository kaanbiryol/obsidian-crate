{
	"$schema": "./node_modules/knip/schema.json",
	"entry": [
		"src/main.ts!",
		"src/cloudflare/worker/index.ts!",
		"src/pwa/main.tsx!",
		"scripts/*.mjs",
		"tests/editor-contract/fixture.tsx",
		"tests/editor-contract/*.spec.ts",
		"tests/editor-contract/*.config.{ts,mts}",
		"tests/reading-extraction/*.ts"
	],
	"project": [
		"tests/visual/**/*.{ts,tsx}",
		"tests/editor-contract/**/*.{ts,tsx,mts}",
		"src/**/*.{ts,tsx}!",
		"scripts/*.mjs",
		"*.{js,mjs,mts,ts}",
		"!src/**/*-test-harness.ts!",
		"!src/test/**!",
		"tests/reading-extraction/*.ts"
	],
	"ignoreFiles": [
		"src/cloudflare/worker/notifications/web-push-library.d.ts",
		"src/cloudflare/worker/cloudflare-env.d.ts",
		"src/cloudflare/worker/pwa/assets.d.ts",
		"src/cloudflare/worker/pwa/raw-css.d.ts",
		"src/cloudflare/worker/raw-text.d.ts"
	],
	"ignoreDependencies": [
		"cloudflare",
		"electron",
		"tailwindcss"
	],
	"ignoreBinaries": [
		"tar",
		"python3",
		"plutil",
		"shortcuts"
	]
}
