{
	"$schema": "./node_modules/knip/schema.json",
	"entry": [
		"src/main.ts",
		"src/cloudflare/worker/index.ts",
		"src/pwa/main.tsx",
		"scripts/*.mjs"
	],
	"project": [
		"src/**/*.{ts,tsx}",
		"scripts/*.mjs",
		"*.{js,mjs,mts,ts}"
	],
	"ignoreFiles": [
		"src/cloudflare/worker/cloudflare-env.d.ts",
		"src/cloudflare/worker/pwa/assets.d.ts",
		"src/cloudflare/worker/pwa/raw-css.d.ts",
		"src/cloudflare/worker/raw-text.d.ts"
	],
	"ignoreDependencies": [
		"cloudflare",
		"preact",
		"tailwindcss"
	]
}
