+ /* Obsidian reminders view parity. Keep this standalone PWA visually aligned with the plugin UI. */
+ :root{
+ 	--background-primary:#0d0d0f;
+ 	--background-primary-alt:#141417;
+ 	--background-secondary:#09090b;
+ 	--background-modifier-border:rgba(255,255,255,.075);
+ 	--background-modifier-border-hover:rgba(255,255,255,.13);
+ 	--background-modifier-hover:rgba(255,255,255,.045);
+ 	--background-modifier-active-hover:rgba(255,255,255,.07);
+ 	--background-modifier-form-field:#18181c;
+ 	--background-modifier-cover:rgba(0,0,0,.55);
+ 	--background-modifier-box-shadow:rgba(0,0,0,.3);
+ 	--text-normal:#f0f0f2;
+ 	--text-muted:#9a9aa3;
+ 	--text-faint:#66666f;
+ 	--text-error:#ef4444;
+ 	--text-warning:#f59e0b;
+ 	--text-success:#22c55e;
+ 	--text-on-accent:#ffffff;
+ 	--interactive-accent:#8b5cf6;
+ 	--interactive-accent-hover:#9b75f7;
+ 	--interactive-normal:rgba(255,255,255,.045);
+ 	--interactive-hover:rgba(255,255,255,.07);
+ 	--shadow-s:0 2px 8px rgba(0,0,0,.18);
+ 	--shadow-l:0 25px 50px -12px rgba(0,0,0,.35);
+ 	--font-interface:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",system-ui,sans-serif;
+ 	--reminder-red:#e53935;
+ 	--accent:#8b5cf6;
+ 	--accent-rgb:139,92,246;
+ 	--accent-strong:#8b5cf6;
+ 	--shadow:none;
+ 	--tabbar-h:80px;
+ 	--reminders-tabbar-height:80px;
+ 	--reminders-fab-gap:16px;
+ 	--reminders-fab-size:48px;
+ }
+ html,body{background:var(--background-primary);font-family:var(--font-interface);color:var(--text-normal)}
+ #app{background:radial-gradient(circle at 84% -10%,rgba(var(--accent-rgb),.075),transparent 33%),var(--background-primary)}
+ .app-shell{background:transparent;--reminders-tabbar-overlay:0px;--reminders-safe-area:0px}
+ .app-header{padding:calc(var(--pwa-safe-area-top) + 17px) 18px 11px;background:rgba(13,13,15,.84);backdrop-filter:blur(24px) saturate(150%);-webkit-backdrop-filter:blur(24px) saturate(150%);border-bottom:1px solid rgba(255,255,255,.06)}
+ .app-header__row{align-items:flex-start;gap:12px}
+ .app-header__body{animation:none}
+ .app-header__body h1{font-size:30px;font-weight:700;line-height:1.12;letter-spacing:-.04em;color:var(--text-normal)}
+ .header-meta{gap:8px;margin-top:4px;min-height:24px;font-size:12.5px;color:var(--text-muted)}
+ .overdue-pill{padding:4px 12px;background:var(--reminder-red);border:none;border-radius:12px;color:white;font-size:14px;font-weight:600}
+ .icon-button{width:44px;height:44px;min-width:44px;border-radius:11px;background:rgba(255,255,255,.04);color:var(--text-muted)}
+ .icon-button.is-active{background:rgba(var(--accent-rgb),.10);color:var(--accent)}
+ .app-content{background:transparent;padding:12px 14px calc(var(--reminders-tabbar-height) + var(--reminders-fab-gap) + var(--reminders-fab-size) + env(safe-area-inset-bottom));overflow-x:hidden}
+ .view-transition{will-change:transform,opacity;transform-origin:center top}
+ .view-transition--forward{animation:view-slide-forward 280ms cubic-bezier(.16,1,.3,1)}
+ .view-transition--backward{animation:view-slide-backward 280ms cubic-bezier(.16,1,.3,1)}
+ .view-transition--none{animation:none}
+ .reminders-stack,.reorder-list,.completed-list{gap:0}
+ .date-group{margin-bottom:20px}
+ .date-group__title{margin:0 0 9px;padding-left:3px;font-size:11px;font-weight:700;color:var(--text-faint);text-transform:uppercase;letter-spacing:.09em}
+ .pwa-reminders-view .premium-checkbox.is-completing .premium-checkbox-visual{animation:pwa-completion-check 360ms cubic-bezier(.16,1,.3,1)}
+ @keyframes pwa-completion-check{0%{transform:scale(.92)}55%{transform:scale(1.14)}100%{transform:scale(1)}}
+ .modal-card,.settings-sheet{background:var(--background-primary);border:1px solid var(--background-modifier-border);border-radius:24px 24px 0 0}
+ .composer-surface,.composer-panel{background:rgba(255,255,255,.015);border:1px solid rgba(255,255,255,.03);border-radius:14px}
+ .field input,.field textarea,.field select{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.08);color:var(--text-normal)}
+ .placeholder-card{min-height:64px;background:rgba(var(--accent-rgb),.08);border:1px dashed rgba(var(--accent-rgb),.35);border-radius:12px}
+ .is-dragging{opacity:.98;box-shadow:0 10px 24px rgba(0,0,0,.25)}
+ .reminders-shadow-root{height:100%;width:100%;max-width:100vw;display:flex;flex-direction:column;overflow:hidden;color:var(--text-normal);font-family:var(--font-interface);font-size:var(--font-ui-medium,14px);background:var(--background-primary)}
+ .pwa-shadow-root>[data-overlay-container="true"]{display:flex;flex:1;min-height:0;width:100%;height:100%;flex-direction:column;overflow:hidden}
